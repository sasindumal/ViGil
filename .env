# ViGiL Environment Configuration
# Copy this file to .env and fill in your values

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: openai | gemini | ollama | lmstudio
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LM Studio (local — OpenAI-compatible, no API key required)
# Base URL shown in LM Studio → Local Server tab (default: http://localhost:1234/v1)
# Model must match exactly what is loaded in the LM Studio UI
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen3.5-4b-claude-4.6-opus-reasoning-distilled-v2

# ─── Threat Intelligence APIs ──────────────────────────────────────────────────
# Leave blank to use mock/demo mode
VIRUSTOTAL_API_KEY=c1afdb57fb2d305e2453b063df91f4fe5a3345ba660f4a3aa0d5b2c0cffee826
MALWAREBAZAAR_API_KEY=84ab5a86fcb2450209722bdf716943aad6e901e654f0eeb
ABUSEIPDB_API_KEY=f6003a1acbb762544e6aa8215c0e8be927d47b4a5a6a3c676282f982f023966ec52a2c0dd1a9311f
ALIENVAULT_OTX_API_KEY=51310dccd0eecfa08f59148bf55a60356bc127c53e61b33481966ffb50e5d380

# ─── Vector Database ───────────────────────────────────────────────────────────
# faiss (default, in-memory) | qdrant
VECTOR_STORE=faiss
QDRANT_URL=http://localhost:6333

# ─── Server ────────────────────────────────────────────────────────────────────
VIGIL_HOST=0.0.0.0
VIGIL_PORT=8000
VIGIL_DEBUG=true

# ─── Analysis Settings ─────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
DEMO_MODE=false
CAPA_TIMEOUT=600         # seconds — increase for large binaries (AcroRd32.exe ~5-10min)

# ─── CrewAI Agentic Reasoning ────────────────────────────────────────────────
CREWAI_ENABLED=true
CREWAI_VERBOSE=false     # set true to see agent thoughts in console
