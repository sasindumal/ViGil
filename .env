# ViGil Model Architecture Settings
HIDDEN_DIM=256
NUM_LAYERS=4
NUM_HEADS=8
DROPOUT=0.1
NUM_CLASSES=2

# ViGil Training Settings
BATCH_SIZE=32
LEARNING_RATE=0.0001
NUM_EPOCHS=50
EARLY_STOPPING_PATIENCE=10
USE_CONTRASTIVE_LOSS=True
CONTRASTIVE_TEMPERATURE=0.07
CHECKPOINT_DIR="./checkpoints"

# Train/Val/Test Split Factors (must sum to 1.0)
TRAIN_RATIO=0.8
VAL_RATIO=0.1
TEST_RATIO=0.1
