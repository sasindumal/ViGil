# ViGil Model Architecture Settings
HIDDEN_DIM=256
NUM_LAYERS=6
NUM_HEADS=8
DROPOUT=0.2
NUM_CLASSES=2

# ViGil Training Settings
BATCH_SIZE=16
LEARNING_RATE=0.0003
NUM_EPOCHS=200
EARLY_STOPPING_PATIENCE=20
USE_CONTRASTIVE_LOSS=True
CONTRASTIVE_TEMPERATURE=0.07
CHECKPOINT_DIR="./checkpoints"

# Train/Val/Test Split Factors (must sum to 1.0)
TRAIN_RATIO=0.8
VAL_RATIO=0.1
TEST_RATIO=0.1

# Learning rate scheduling and optimization options
USE_LR_SCHEDULER=True
LR_SCHEDULER_TYPE="cosine_warmup"
WARMUP_EPOCHS=5
MIN_LR=1e-06

# Regularization: Label smoothing and Focal Loss
LABEL_SMOOTHING=0.1
USE_FOCAL_LOSS=False
FOCAL_LOSS_GAMMA=2.0

# Exponential Moving Average (EMA)
USE_EMA=True
EMA_DECAY=0.999

# Graph Data Augmentations
USE_AUGMENTATION=True
AUG_FEATURE_MASK_RATE=0.15
AUG_EDGE_DROP_RATE=0.05
