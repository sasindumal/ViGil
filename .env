# ViGil Model Architecture Settings
EMBEDDING_DIM=320
HIDDEN_DIM=256
NUM_LAYERS=4
NUM_HEADS=8
DROPOUT=0.15
NUM_CLASSES=2

# ViGil Training Settings
BATCH_SIZE=32
LEARNING_RATE=0.0001
NUM_EPOCHS=100
EARLY_STOPPING_PATIENCE=15
USE_CONTRASTIVE_LOSS=True
CONTRASTIVE_TEMPERATURE=0.07
CHECKPOINT_DIR="./checkpoints"

# Learning Rate Scheduling
USE_LR_SCHEDULER=True
LR_SCHEDULER_TYPE=cosine_warmup
WARMUP_EPOCHS=5
MIN_LR=0.000001

# Loss & Regularisation
LABEL_SMOOTHING=0.05
USE_FOCAL_LOSS=False
FOCAL_LOSS_GAMMA=2.0

# EMA (Exponential Moving Average) — smooths weights for better generalisation
USE_EMA=True
EMA_DECAY=0.9995

# Data Augmentation
USE_AUGMENTATION=True
AUG_FEATURE_MASK_RATE=0.10
AUG_EDGE_DROP_RATE=0.05

# Train/Val/Test Split Factors (must sum to 1.0)
TRAIN_RATIO=0.8
VAL_RATIO=0.1
TEST_RATIO=0.1
