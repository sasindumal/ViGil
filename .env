# ViGiL Environment Configuration
# Copy this file to .env and fill in your values

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: openai | gemini | ollama
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Threat Intelligence APIs ──────────────────────────────────────────────────
# Leave blank to use mock/demo mode
VIRUSTOTAL_API_KEY=
MALWAREBAZAAR_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=

# ─── Vector Database ───────────────────────────────────────────────────────────
# faiss (default, in-memory) | qdrant
VECTOR_STORE=faiss
QDRANT_URL=http://localhost:6333

# ─── Server ────────────────────────────────────────────────────────────────────
VIGIL_HOST=0.0.0.0
VIGIL_PORT=8000
VIGIL_DEBUG=true

# ─── Analysis Settings ─────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
DEMO_MODE=true
