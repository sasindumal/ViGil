# LLM Configuration Provider: openai, ollama, lmstudio
LLM_PROVIDER=lmstudio

# OpenAI settings
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL_NAME=gpt-4o

# Ollama settings (e.g., http://localhost:11434)
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# LM Studio settings (e.g., http://localhost:1234/v1)
LMSTUDIO_API_BASE=http://localhost:1234/v1
LMSTUDIO_MODEL_NAME=qwen3.5-0.8b-claude-4.6-opus-reasoning-distilled

# Search API Key (Optional: Tavily or Serper)
# TAVILY_API_KEY=your-tavily-key

# Server settings
PORT=8000
HOST=0.0.0.0
